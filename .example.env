# Copy to .env. docker-compose reads it for both services.

# API
PORT=8080
# Host "postgres" is the compose service name.
DATABASE_URL=postgres://gymbro:gymbro@postgres:5432/gymbro?sslmode=disable

# Shared secret clients send as "Authorization: Bearer <secret>".
API_SECRET=change-me

# Telegram bot
# Token from @BotFather. Secret: never commit the real one.
BOT_TOKEN=123456:dummy-token
# Where the bot reaches the API. Host "api" is the compose service name.
API_BASE_URL=http://api:8080
# The only Telegram user ID the bot talks to (private chats only).
ALLOWED_TELEGRAM_USER_ID=123456789
# Bot SQLite file. /data is the botdata volume in docker-compose.
BOT_DB_PATH=/data/bot.db

# Postgres container (must match DATABASE_URL)
POSTGRES_USER=gymbro
POSTGRES_PASSWORD=gymbro
POSTGRES_DB=gymbro

# Web
# Which user's workouts the web app shows.
VITE_USER_ID=1
# Where the Vite dev server proxies /api/* (adds API_SECRET server-side). Host "api" is the compose service name.
API_PROXY_TARGET=http://api:8080
